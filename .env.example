# Everything here is optional. With no .env file at all the app runs on an
# embedded Postgres (PGlite) with a deterministic local embedding model, so
# `npm run db:reset && npm run dev` works offline.

# ── Database ──────────────────────────────────────────────────────────────────
# Unset: PGlite writes to ./.pglite (zero setup, pgvector included).
# Set: any Postgres 15+ with the vector extension available (Supabase, Neon, RDS).
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_atlas

# Where the embedded database stores its files.
# PGLITE_DATA_DIR=.pglite

# ── AI provider ───────────────────────────────────────────────────────────────
# Unset: the mock provider runs the rule-based analyser, which is fully offline
# and deterministic. Set a key to use a real model for submission analysis.
# AI_PROVIDER=mock | openai | anthropic
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Site ──────────────────────────────────────────────────────────────────────
# Used for canonical URLs, Open Graph tags and the sitemap.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
